# JMLP Environment Configuration
# 1. Zkopírujte: cp .env.example .env
# 2. Upravte hodnoty níže

# Database
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_PASSWORD=your_strong_app_password_here
DATABASE_URL=mysql+pymysql://app:your_strong_app_password_here@db:3306/jmlpcz?charset=utf8mb4

# JWT (vygenerujte: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_64_character_hex_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & API
CORS_ORIGINS=http://localhost:3000
VITE_API_BASE=http://localhost:8000

# Pro produkci:
# - Změňte hesla na silné (min 16 znaků)
# - CORS_ORIGINS=https://vase-domena.cz
# - VITE_API_BASE=https://api.vase-domena.cz
# - Admin: admin@jmlp.cz / admin123 (změňte po nasazení!)