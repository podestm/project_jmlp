[Unit]
Description=JMLP: automatické nasazení větve main na produkci jmlp.cz
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Stejný uživatel, kterému patří /opt/jmlp (ověřit: stat -c %U /opt/jmlp).
User=podm12
Group=podm12
SupplementaryGroups=docker
Environment=HOME=/home/podm12
# Zálohy před nasazením a značka selhaného commitu: /var/lib/jmlp-deploy
StateDirectory=jmlp-deploy
StateDirectoryMode=0700
# DISCORD_WEBHOOK_URL pro hlášení výsledku (nepovinné; "-" = soubor nemusí existovat).
EnvironmentFile=-/opt/jmlp-ops/.env
ExecStart=/opt/jmlp/deploy/prod/auto-deploy-main.sh
Nice=10
