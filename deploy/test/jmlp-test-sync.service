[Unit]
Description=JMLP: kopie produkce (DB + dokumenty) do testu preprodtest.jmlp.cz
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/jmlp-test/deploy/test/sync-prod-to-test.sh
# Nízká priorita, aby kopie nebrzdila produkci.
Nice=15
IOSchedulingClass=idle
CPUWeight=20
