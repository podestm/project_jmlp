# /opt/jmlp-test/.env  (chmod 600) - VŠECHNY hodnoty jiné než v produkci!
MYSQL_ROOT_PASSWORD=<nove-min-16-znaku>
MYSQL_DATABASE=jmlpcz
MYSQL_USER=app
MYSQL_PASSWORD=<nove-min-16-znaku>
DATABASE_URL=mysql+pymysql://app:<MYSQL_PASSWORD>@db:3306/jmlpcz?charset=utf8mb4
# Jiný klíč než produkce -> přihlášení z testu neplatí na produkci a naopak.
SECRET_KEY=<novy-min-32-znaku>
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=https://preprodtest.jmlp.cz
VITE_API_BASE=
# SLCR_* sem NEPATŘÍ (docker-compose.test.yml je stejně vynuluje).
