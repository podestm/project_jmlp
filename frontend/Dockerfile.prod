# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (vcetne dev dependencies pro build)
RUN npm install && \
    npm cache clean --force

# Copy source code
COPY . .

# Build argument pro API base URL
ARG VITE_API_BASE
ENV VITE_API_BASE=${VITE_API_BASE}

# Build aplikace
RUN npm run build

# Production stage s Nginx
FROM nginx:alpine

# Instalace curl a openssl pro health check a TLS certifikat
RUN apk add --no-cache curl openssl

# Generovani self-signed TLS certifikatu
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout /etc/nginx/ssl/nginx.key \
        -out /etc/nginx/ssl/nginx.crt \
        -subj "/CN=JMLP" \
        -addext "subjectAltName=IP:76.13.79.188,IP:127.0.0.1,DNS:localhost"

# Vytvoreni non-root uzivatele
RUN adduser -D -u 1000 appuser && \
    chown -R appuser:appuser /var/cache/nginx && \
    chown -R appuser:appuser /var/log/nginx && \
    chown -R appuser:appuser /etc/nginx/conf.d && \
    chown -R appuser:appuser /etc/nginx/ssl && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appuser /var/run/nginx.pid

# Kop�rov�n� built assets z builder stage
COPY --from=builder --chown=appuser:appuser /app/dist /usr/share/nginx/html

# Kop�rov�n� Nginx konfigurace
COPY --chown=appuser:appuser nginx.conf /etc/nginx/conf.d/default.conf

# Switch na non-root user
USER appuser

# Expose ports
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]