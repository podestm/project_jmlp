# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (vcetne dev dependencies pro build)
RUN npm install && \
    npm cache clean --force

# Copy source code
COPY . .

# Build argument pro API base URL
ARG VITE_API_BASE
ENV VITE_API_BASE=${VITE_API_BASE}

# Build aplikace
RUN npm run build

# Production stage s Nginx
FROM nginx:alpine

# Instalace curl pro health check
RUN apk add --no-cache curl

# Vytvorení non-root uživatele
RUN adduser -D -u 1000 appuser && \
    chown -R appuser:appuser /var/cache/nginx && \
    chown -R appuser:appuser /var/log/nginx && \
    chown -R appuser:appuser /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appuser /var/run/nginx.pid

# Kopírování built assets z builder stage
COPY --from=builder --chown=appuser:appuser /app/dist /usr/share/nginx/html

# Kopírování Nginx konfigurace
COPY --chown=appuser:appuser nginx.conf /etc/nginx/conf.d/default.conf

# Switch na non-root user
USER appuser

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]